    "@capacitor/ios": "^8.0.0",
    "nasr-secure-store": "file:./native-secure-store"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
